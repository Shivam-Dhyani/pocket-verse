# ============================================================
# Pocketverse environment — copy to .env and fill in.
# No real values in this file, ever. Secrets live only in env.
# ============================================================

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000

# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocketverse

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=

# Master keyring for envelope encryption (AES-256-GCM).
# Format: comma-separated `keyId:base64Key` pairs, each key exactly 32 bytes.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add a new pair, point MASTER_KEY_ACTIVE at it, re-wrap stored keys, drop the old pair.
MASTER_KEYS=k1:
MASTER_KEY_ACTIVE=k1

# Allowed browser origin for the web app
CORS_ORIGIN=http://localhost:3000

# MTProto application credentials — create once at https://my.telegram.org
# (API development tools). These identify the app, not any user account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: Redis for the upload/download job queue (Upstash free tier works).
# Leave empty to run jobs in-process (fine for local dev and single instances).
REDIS_URL=

# Storage engine tuning (defaults shown; leave empty to use them).
# CHUNK_SIZE_BYTES=1500000000        # one Telegram message per chunk (1.5GB)
# UPLOAD_PART_SIZE_BYTES=8388608     # HTTP upload part size (8MB)
# STAGING_DIR=.staging               # temp disk area for in-flight chunks

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# Folder-upload guardrails (file counts; defaults shown — leave empty to use them).
# Baked in at build time (NEXT_PUBLIC_), so changing them needs a web rebuild.
# NEXT_PUBLIC_UPLOAD_WARN_FILE_COUNT=500    # above this: "big upload" confirm
# NEXT_PUBLIC_UPLOAD_MAX_FILE_COUNT=2000    # above this: ask to split into batches
# NEXT_PUBLIC_UPLOAD_SUGGESTED_BATCH=300    # batch size suggested in that message
