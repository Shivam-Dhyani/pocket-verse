generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  passwordHash   String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  connection     StorageConnection?
  auditEvents    AuditEvent[]
  folders        Folder[]
  files          File[]
  uploadSessions UploadSession[]
}

enum ConnectionStatus {
  PENDING_CODE
  PENDING_PASSWORD
  CONNECTED
  ERROR
}

model StorageConnection {
  id     String           @id @default(cuid())
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String           @unique
  status ConnectionStatus

  // Display-only masked phone (e.g. "+91••••••1234") plus the full number,
  // envelope-encrypted with the connection data key — revealed only via an
  // authenticated, audited endpoint.
  phoneMasked    String
  encryptedPhone String?

  // Envelope encryption: per-connection data key wrapped by the master keyring
  // (AAD-bound to the user). The session string is encrypted with the data key.
  wrappedDataKey   String
  encryptedSession String?

  // Multi-step login state: encrypted JSON {tempSession, phoneCodeHash, phone},
  // valid until pendingExpiresAt. Survives server restarts/sleeps.
  encryptedPending String?
  pendingExpiresAt DateTime?

  // Private storage channel created for the user (ids are Telegram bigints).
  channelId         String?
  channelAccessHash String?

  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum FileStatus {
  UPLOADING
  READY
  ERROR
}

enum ChunkStatus {
  PENDING
  UPLOADING
  UPLOADED
  ERROR
}

model Folder {
  id       String   @id @default(cuid())
  name     String
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children Folder[] @relation("FolderTree")
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  files    File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, parentId, name])
  @@index([ownerId, parentId])
}

model File {
  id       String     @id @default(cuid())
  name     String
  size     BigInt
  mimeType String
  status   FileStatus @default(UPLOADING)
  // sha256 of the content; multi-chunk files store a composite hash
  // ("composite:" + sha256 over the ordered chunk hashes).
  checksum String?

  totalChunks   Int
  folder        Folder?        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId      String?
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       String
  chunks        FileChunk[]
  uploadSession UploadSession?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, folderId])
  @@index([ownerId, name])
}

model FileChunk {
  id                String      @id @default(cuid())
  file              File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId            String
  index             Int
  size              BigInt
  checksum          String?
  telegramMessageId String?
  status            ChunkStatus @default(PENDING)
  attempts          Int         @default(0)
  // Transfer progress to storage, 0-100 — drives the UI's sync percentage.
  progress          Int         @default(0)

  @@unique([fileId, index])
}

model UploadSession {
  id      String @id @default(cuid())
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId  String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  // Parts arrive strictly in order; nextPart is the resume cursor.
  partSize   Int
  chunkSize  Int
  totalParts Int
  nextPart   Int      @default(0)
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // Only a SHA-256 hash of the token is stored; the raw token exists solely
  // inside the reset link sent to the account's email.
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  // Only a SHA-256 hash of the token is stored — the raw token exists solely in the client cookie.
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
